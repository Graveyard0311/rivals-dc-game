{
  "name": "rivals-dc-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "check:server": "node --check server/index.js",
    "test:network": "node tests/network.integration.mjs",
    "desktop": "electron desktop/main.cjs",
    "desktop:dist": "npm run build && electron-builder --publish never",
    "test:teamups": "node tests/teamups.mjs",
    "test:bots": "node tests/bot-difficulty.mjs"
  },
  "dependencies": {
    "three": "^0.180.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "vite": "^7.1.3",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.graveyard0311.rivalscollision",
    "productName": "Rivals Collision",
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.games"
    }
  },
  "description": "Private browser-first Marvel/DC hero shooter prototype",
  "author": "Graveyard0311"
}
